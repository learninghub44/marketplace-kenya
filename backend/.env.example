# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=https://your-cloudflare-pages-url.pages.dev

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Configuration
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# PayHero Configuration
PAYHERO_USERNAME=your_payhero_username
PAYHERO_PASSWORD=your_payhero_password
PAYHERO_CALLBACK_URL=https://your-render-url.onrender.com/api/payhero/callback

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Optional: auto-create an admin account on first boot if it doesn't exist.
# Leave unset to skip auto-seeding and create admin accounts manually instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key

# SMS Configuration (Africa's Talking)
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=your_africastalking_username

# Didit identity verification (KYC) — v3 API, https://docs.didit.me
# Setup:
#   1. Sign up free at https://business.didit.me (500 verifications/month free, no card required)
#   2. Create a verification workflow in the console -> copy its workflow_id
#   3. Copy your API key from the console -> DIDIT_API_KEY
#   4. Register a webhook destination (POST /v3/webhook/destinations/, or via console)
#      pointing at https://<your-backend>/api/seller/kyc-webhook, subscribed to
#      "status.updated". The response gives you a secret_shared_key -> DIDIT_WEBHOOK_SECRET
# Leave all four unset to run kyc-start in demo mode (status will be stuck at
# "pending" forever — fine for local frontend dev, not for production).
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=https://your-frontend-url/seller/kyc
